<?xml version="1.0" encoding="UTF-8" ?>
<service>
  <!-- Windows 服务配置 - 使用 WinSW 注册服务 -->
  <!-- 下载地址: https://github.com/winsw/winsw/releases -->
  
  <id>polyin-inventory</id>
  <name>保利管道库存管理系统</name>
  <description>保利管道个体经营户商品入库出库管理系统服务</description>
  
  <!-- Java 可执行文件路径（如果 JAVA_HOME 已配置可留空） -->
  <!-- <executable>C:\Program Files\Java\jdk1.8.0_181\bin\java.exe</executable> -->
  <executable>java</executable>
  
  <!-- 启动参数 -->
  <arguments>-jar -Xms512m -Xmx1024m -Dfile.encoding=UTF-8 "%BASE%\target\polyin-inventory.jar"</arguments>
  
  <!-- 启动类型：Automatic（自动）或 Manual（手动） -->
  <startmode>Automatic</startmode>
  
  <!-- 日志配置 -->
  <log mode="roll">
    <path>%BASE%\logs</path>
    <keepNumber>10</keepNumber>
  </log>
  
  <!-- 失败重试 -->
  <retry onfailure="10000">
    <delay>30000</delay>
    <count>3</count>
  </retry>
  
  <!-- 停止超时时间（毫秒） -->
  <stoptimeout>30000</stoptimeout>
  
  <!-- 环境变量 -->
  <env name="JAVA_OPTS" value="-Xms512m -Xmx1024m" />
</service>
